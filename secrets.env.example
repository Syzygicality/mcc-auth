# Copy to ~/secrets.env on the phone server and fill in real values.
# Sourced by sv/keycloak/run. Never commit the filled-in copy.

# Admin account for the Keycloak console. Pick a non-obvious username.
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
# Must match the password of the "keycloak" postgres role.
KC_DB_PASSWORD=
# Public origin Keycloak advertises, e.g. https://auth.example.com
KC_HOSTNAME=
